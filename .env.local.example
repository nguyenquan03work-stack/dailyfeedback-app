# --- Google Sheets service account credentials ---
# 1) In Google Cloud Console create a Service Account and a JSON key.
# 2) Enable the "Google Sheets API" for the project.
# 3) Share your spreadsheet with the service account email (Viewer is enough for reading).

# The service account email, e.g. my-app@my-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The private key from the JSON file. Keep the surrounding quotes and the literal \n sequences.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# The spreadsheet ID (the long string in the sheet URL between /d/ and /edit)
GOOGLE_SHEET_ID=

# --- Gemini (Google AI Studio) for reading the diary photo ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
